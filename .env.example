# ============================================================
# Sonic Blueprint Engine — configuration
# Copy this file to .env and fill in the values you need.
# ============================================================

# --- Model provider (choose ONE) ----------------------------
# gemini (default) | openai | anthropic | openai-compatible
LLM_PROVIDER=gemini

# Model name. Defaults per provider:
#   gemini            -> gemini-2.5-flash
#   openai            -> gpt-4o
#   anthropic         -> claude-sonnet-4-5
#   openai-compatible -> required (e.g. llama3.1, qwen2.5, deepseek-r1)
LLM_MODEL=gemini-2.5-flash

# API key for your provider (the gemini provider also accepts
# GEMINI_API_KEY below as a fallback).
LLM_API_KEY=

# Base URL for openai-compatible providers only:
#   Ollama (local)     -> http://localhost:11434/v1
#   vLLM / LM Studio   -> http://localhost:8000/v1
#   Groq               -> https://api.groq.com/openai/v1
LLM_BASE_URL=

# --- Gemini only (fallback for LLM_API_KEY) -----------------
GEMINI_API_KEY=
